# =========================
# HunterOps Core Identity
# =========================
HUNTER_NAME=
HUNTER_EMAIL=
HACKERONE_USERNAME=
BUGCROWD_USERNAME=

# =========================
# Database (Postgres 14+)
# =========================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=hunter
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hunterops
HUNTEROPS_POSTGRES_DSN=postgresql://hunter:change_me@db:5432/hunterops
HUNTEROPS_REDIS_URL=redis://redis:6379/0
HUNTEROPS_PG_CONNECT_TIMEOUT_SECONDS=5
HUNTEROPS_PG_STATEMENT_TIMEOUT_MS=12000
HUNTEROPS_PG_LOCK_TIMEOUT_MS=3000
HUNTEROPS_PG_IDLE_IN_TX_TIMEOUT_MS=20000

# =========================
# API Tokens / Integrations
# =========================
H1_API_IDENTIFIER=reaperk0ji
H1_API_IDENTIFIER_FILE=
H1_API_TOKEN=
H1_API_TOKEN_FILE=
# Program submission headers (bug bounty guideline)
HUNTEROPS_BUG_BOUNTY_USERNAME=reaperk0ji
HUNTEROPS_TEST_ACCOUNT_EMAIL=
HACKERONE_API_USER=
HACKERONE_API_TOKEN=
HACKERONE_API_USER_FILE=
HACKERONE_API_TOKEN_FILE=
INTIGRITI_API_TOKEN=
INTIGRITI_API_TOKEN_FILE=
BUGCROWD_API_TOKEN=
BUGCROWD_API_TOKEN_FILE=
HACKERONE_PROGRAM_HANDLE=
HACKERONE_PROGRAM_HANDLE_FILE=

# =========================
# Session Profiles (Optional)
# =========================
HUNTEROPS_USER_TOKEN=
HUNTEROPS_USER_COOKIE=
HUNTEROPS_USER_B_TOKEN=
HUNTEROPS_USER_B_COOKIE=
HUNTEROPS_ADMIN_TOKEN=
HUNTEROPS_ADMIN_COOKIE=
# SessionGuardian credential envs (used with config/vault.yaml)
HUNTEROPS_USER_USERNAME=
HUNTEROPS_USER_PASSWORD=
HUNTEROPS_USER_B_USERNAME=
HUNTEROPS_USER_B_PASSWORD=

# =========================
# Notifications / Mobile Alerts
# =========================
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_FILE=
MONITOR_DISCORD_WEBHOOK=
MONITOR_DISCORD_WEBHOOK_FILE=
HUNTEROPS_CRITICAL_WEBHOOK=
HUNTEROPS_DISCORD_RECON_WEBHOOK=
HUNTEROPS_DISCORD_RECON_WEBHOOK_FILE=
HUNTEROPS_DISCORD_FINDINGS_WEBHOOK=
HUNTEROPS_DISCORD_FINDINGS_WEBHOOK_FILE=
HUNTEROPS_DISCORD_RESEARCH_WEBHOOK=
HUNTEROPS_DISCORD_CRITICAL_WEBHOOK=
HUNTEROPS_SLACK_RESEARCH_WEBHOOK=
HUNTEROPS_SLACK_CRITICAL_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID=

# =========================
# OOB / External Callback
# =========================
HUNTEROPS_OOB_CALLBACK_DOMAIN=
HUNTEROPS_OOB_POLL_URL=
HUNTEROPS_OOB_POLL_URL_FILE=
HUNTEROPS_OOB_API_TOKEN=
HUNTEROPS_OOB_API_TOKEN_FILE=

# =========================
# Target Inputs
# =========================
TARGETS_FILE=config/targets/admissions_in_scope_hosts.txt
TARGET_LIST=

# =========================
# Runtime / Scheduling
# =========================
HUNTEROPS_HOME=/opt/hunterops
RUN_INTERVAL_SECONDS=300
RUN_MAX_SECONDS=1800
RUN_JITTER_SECONDS=20
RUN_MAX_BACKOFF_SECONDS=300
MONITOR_INTERVAL_HOURS=6
MONITOR_DEADMAN_HOURS=24

# =========================
# Governance / ROE
# =========================
HUNTEROPS_REQUIRE_PROGRAM_MATCH=1
HUNTEROPS_ENFORCE_ALLOWED_HOURS=1
HUNTEROPS_REQUIRE_PROGRAM_HEADERS=1
HUNTEROPS_REQUIRE_SIGNED_SCOPE=0
HUNTEROPS_SCOPE_EXPIRY_WARN_DAYS=7

# =========================
# Resource Limits (docker-compose)
# =========================
APP_CPUS=1.5
APP_MEM_LIMIT=2g
APP_MEM_RESERVATION=1g
DB_CPUS=1.0
DB_MEM_LIMIT=1g
DB_MEM_RESERVATION=512m
REDIS_CPUS=0.5
REDIS_MEM_LIMIT=256m
REDIS_MEM_RESERVATION=128m
MONITOR_CPUS=0.5
MONITOR_MEM_LIMIT=256m
MONITOR_MEM_RESERVATION=128m
OOB_CPUS=0.5
OOB_MEM_LIMIT=512m
