{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HunterOps Scope",
  "type": "object",
  "required": ["targets", "authorized_by", "valid_from", "valid_to", "rules_of_engagement", "signature_meta", "signature"],
  "properties": {
    "targets": {
      "type": "array",
      "items": {"type": "string"}
    },
    "authorized_by": {"type": "string"},
    "valid_from": {"type": "string"},
    "valid_to": {"type": "string"},
    "rules_of_engagement": {"type": "string"},
    "signature_meta": {
      "type": "object",
      "properties": {
        "algorithm": {"type": "string"},
        "created_at": {"type": "string"}
      },
      "required": ["algorithm"]
    },
    "signature": {"type": "string"}
  }
}
